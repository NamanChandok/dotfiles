* {
    font: "Segoe UI 11";

    nord0: #0f0f0f;
    nord1: #1e1e1e;
    nord2: #2b2b2b;
    nord3: #3a3a3a;

    nord4: #c1c1c1;
    nord5: #eeeeee;
    nord6: #eeeeee;

    accent-color: #2d2d2d;
    highlight-color: #3c3c3c;
    border-color: #2f2f2f;
    indicator-color: #5f8787;

    background-color: transparent;
    text-color: @nord4;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    background-color: @nord0;
    border: 1px;
    border-color: @border-color;
    border-radius: 12px;
    location: center;
    width: 600px;
    padding: 8px;
}

inputbar {
    border-radius: 8px;
    padding: 10px 14px;
    spacing: 10px;
    children: [prompt, entry];
}

prompt, entry, element-text, element-icon {
    vertical-align: 0.5;
}

prompt {
    text-color: #888888;
}

entry {
    text-color: @nord5;
    expand: true;
    placeholder: "Type here to search...";
}

listview {
    background-color: transparent;
    lines: 8;
    columns: 1;
    fixed-height: false;
    padding: 8px 0 0 0;
    border: 1px 0 0 0;             /* top border only */
    border-color: @border-color;
    margin: 8px 0 0 0;
}

element {
    background-color: transparent;
    padding: 10px;
    spacing: 10px;
    border-radius: 6px;
}

element normal {
    text-color: @nord5;
}

element selected {
    background-color: @nord1;
    text-color: @nord5;
    border: 0px 0px 0px 3px; /* left border only */
    border-color: @indicator-color;
    border-radius: 0px 6px 6px 0px;
}

element-icon {
    size: 24;
}

element-text {
    text-color: inherit;
}
